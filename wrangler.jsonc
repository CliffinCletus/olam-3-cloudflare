{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olam-3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "6bd8375c7cca4fd8eaf69bd021930752",
  "workers_dev": true,
  "routes": [{ "pattern": "olam3-0.petryxion.com", "custom_domain": true }],
  "observability": { "enabled": true },

  // The React PWA (built by Vite into ./dist) is served as static assets.
  // /api/* always hits the Worker; every other unknown path falls back to index.html (SPA routing).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olam3-db",
      "database_id": "c4dc1b59-8ded-41d7-8960-4d278ccbed8b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "JWT_ISSUER": "olam3-api"
  }
  // Secrets (set with `npm run secrets` or `npx wrangler secret put <NAME>`):
  //   JWT_SECRET              random string, signs staff sessions and derives QR pass tokens
  //   INITIAL_ADMIN_EMAIL     the first super admin, created on its first sign-in with INITIAL_ADMIN_PASSWORD
  //   INITIAL_ADMIN_PASSWORD  bootstrap password for INITIAL_ADMIN_EMAIL (must be changed on first sign-in)
}
